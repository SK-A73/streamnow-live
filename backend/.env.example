PORT=5000
FRONTEND_URL=http://localhost:5173

# LiveKit Cloud or Self-Hosted Configuration
# Obtain these from your LiveKit Cloud project dashboard: https://cloud.livekit.io/
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Demo Streamer Access Secret (protects streamer publishing and stream controls)
# Default for demo testing: streamer123
STREAMER_ACCESS_SECRET=streamer123
